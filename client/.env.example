# ---------------------------------------------------------------------------
# Frontend settings for local development.
#
#   1. Copy this file to client/.env.local   (git-ignored, never commit it)
#   2. Fill in the values
#   3. npm run dev
#
# Production: VITE_API_URL is set in client/fly.toml ([build.args]).
# ---------------------------------------------------------------------------

# URL of the ASP.NET Core API.
# PUBLIC: every variable starting with VITE_ is built into the JavaScript that
# visitors download. Never put a secret in a VITE_ variable.
VITE_API_URL=http://localhost:5039

# DeepL API key, used ONLY by `npm run translate` on your machine.
# Must NOT start with VITE_ (it would end up in the website).
# Free key: https://www.deepl.com/pro-api  (free keys end with ":fx")
DEEPL_API_KEY=
