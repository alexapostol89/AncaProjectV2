# ---------------------------------------------------------------------------
# API settings for local development.
#
#   1. Copy this file to server/api/.env   (git-ignored, never commit it)
#   2. Fill in the values
#   3. dotnet run  → the API loads .env automatically
#
# Production uses the SAME names as Fly secrets:
#   fly secrets set Jwt__Key="..." -a anca-api
#
# "__" means nesting: Jwt__Key is the setting Jwt:Key in appsettings.json.
# Non-secret settings (CORS origins, JWT lifetime, ...) live in appsettings*.json.
# Empty values are ignored.
# ---------------------------------------------------------------------------

# Database: Neon PostgreSQL, the *dev* branch, POOLED host (contains "-pooler").
# Neon console → Connect → Connection pooling on. Format:
# Host=ep-xxxxx-pooler.c-7.eu-central-1.aws.neon.tech;Database=neondb;Username=neondb_owner;Password=...;SSL Mode=Require
ConnectionStrings__Default=

# Signs login tokens. At least 32 characters. Generate one: openssl rand -base64 48
Jwt__Key=

# Resend API key for emails. Leave empty locally: password-reset links are then
# printed in the API console instead of being emailed.
Email__ApiKey=

# First admin account, created at startup if this email doesn't exist yet.
# Optional locally; you can remove the password once the account exists.
Seed__AdminEmail=
Seed__AdminPassword=
Seed__AdminFullName=
